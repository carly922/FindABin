<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BackGroundGreen"
    android:fitsSystemWindows="true"
    tools:context=".StartScreen">

    <View
        android:id="@+id/whiteBackGround"
        android:layout_width="400dp"
        android:layout_height="601dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/findABin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="548dp"
        android:text="Welcome to"
        android:textSize="39.7sp"
        app:layout_constraintBottom_toBottomOf="@+id/whiteBackGround"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/whiteBackGround" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find A Bin"
        android:textSize="51.3sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/findABin" />

    <ImageView
        android:id="@+id/recycleIcon"
        android:layout_width="183dp"
        android:layout_height="192dp"
        app:layout_constraintBottom_toTopOf="@+id/createAccount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7"
        app:layout_constraintVertical_bias="0.551"
        app:srcCompat="@drawable/find_a_bin" />

    <Button
        android:id="@+id/createAccount"
        android:layout_width="329dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="242dp"
        android:backgroundTint="@color/BackGroundGreen"
        android:text="Button"
        android:textSize="34.8sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView7"
        tools:text="Create Account" />

    <Button
        android:id="@+id/logIn"
        android:layout_width="325dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/BackGroundGreen"
        android:text="Button"
        android:textSize="34.8sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/createAccount"
        tools:text="Log In" />

</androidx.constraintlayout.widget.ConstraintLayout>